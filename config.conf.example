[device]
; how to locate the device: `ip` (use the address below) or
; `mac` (scan the LAN for the MAC; `ip` is then just a discovery cache)
resolution = ip
ip = 192.168.1.10
; mac = 48:d0:1c:aa:bb:cc
username = admin
password = CHANGE_ME

[gateway]
punch_url = https://api.storeyes.io/api/staff/employee-logs/punch
work_mode_url = https://api.storeyes.io/api/staff/work-mode
; api_key = CHANGE_ME
